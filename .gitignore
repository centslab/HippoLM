# --- Tracked binaries -------------------------------------------------
# Prebuilt Marlin FP4 kernels are versioned as code: per-arch SASS whose
# build provenance (GPU / driver / CUDA / torch) is recorded in
# src/models/ops/cuda/lib/MANIFEST.md. These override the generic *.so
# / lib/ ignores above so the .so ships in-tree (no 35-min JIT on first
# step). Rebuild per machine via scripts/build_marlin.py.
!src/models/ops/cuda/lib/
!src/models/ops/cuda/lib/**

# --- Vendored build caches --------------------------------------------
# The Marlin FP4 source tree under src/models/ops/cuda/marlin_build/ uses
# ninja; per-arch intermediates (kernel_only.cuda.o, repack.cuda.o) are
# emitted into a ``.build/<sm>`` subtree and rebuilt on every script
# invocation. These are NOT the shipped .so artifacts — those live under
# src/models/ops/cuda/lib/. The vendored sources themselves (cuda, core,
# libtorch_stable, marlin/) ARE tracked; only the build cache is local.
src/models/ops/cuda/marlin_build/sources/.build/

# JIT-built fused-OpenMP extension for v4's worker
# (src/training/param_offload/per_layer_gpu_accum.py). Built once on
# first import via torch.utils.cpp_extension.load_inline; falls back
# to the pure-Python worker if compile fails.
src/training/param_offload/_fused_ext_build/
