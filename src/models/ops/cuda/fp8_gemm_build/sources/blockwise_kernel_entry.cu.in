// FP8 E4M3 GEMM with BF16 per-1x32 K-block scales.
#include "fp8_gemm.cuh"

extern "C" void blockwise_gemm_run(
    int M, int N, int K,
    const void *A, const void *B, void *Y,
    const void *a_scale, const void *b_scale,
    void *workspace, cudaStream_t stream)
{
    (void)workspace;
    FP8GemmMMA<BM, BN, BK, NUM_STAGES, CWG, WARP_M, WARP_N, DIRECT_STORE, true,
               /*DUAL_ACCUM=*/false, /*BLOCK_SCALE_K=*/32,
               /*BLOCK_TILE_SCALE=*/false, /*BLOCK_OUT_M=*/64, /*BLOCK_OUT_N=*/64,
               /*BLOCK_ACCUM=*/false, /*SCALE_FP32=*/false, /*PERSISTENT=*/false>::run(
        M, N, K,
        reinterpret_cast<const fp8e4m3 *>(A),
        reinterpret_cast<const fp8e4m3 *>(B),
        nullptr, nullptr,
        reinterpret_cast<const void *>(a_scale),
        reinterpret_cast<const void *>(b_scale),
        reinterpret_cast<bf16 *>(Y),
        /*tile_counter=*/nullptr,
        stream);
}
