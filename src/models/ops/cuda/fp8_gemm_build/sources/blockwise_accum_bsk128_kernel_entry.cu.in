// R6 native-accumulate FP8 GEMM: BLOCK_SCALE_K=128, 64×64 output tile.
// Sub-MMAs within each 128-K scale-block chain via the tensor core's
// native accumulation; one FFMA per (mi,ni) flushes the block. FFMA count
// per (mi,ni) per GEMM = 4·K/128 (vs 4 per sub-MMA in the R5b path).
#include "fp8_gemm.cuh"

extern "C" void blockwise_accum_bsk128_gemm_run(
    int M, int N, int K,
    const void *A, const void *B, void *Y,
    const void *a_scale, const void *b_scale,
    void *workspace, cudaStream_t stream)
{
    (void)workspace;
    FP8GemmMMA<BM, BN, BK, NUM_STAGES, CWG, WARP_M, WARP_N, DIRECT_STORE,
               true, /*DUAL_ACCUM=*/false, /*BLOCK_SCALE_K=*/128,
               /*BLOCK_TILE_SCALE=*/true, /*BLOCK_OUT_M=*/64,
               /*BLOCK_OUT_N=*/64, /*BLOCK_ACCUM=*/true,
               /*SCALE_FP32=*/false,
               /*PERSISTENT=*/false>::run(
        M, N, K,
        reinterpret_cast<const fp8e4m3 *>(A),
        reinterpret_cast<const fp8e4m3 *>(B),
        nullptr, nullptr,
        reinterpret_cast<const void *>(a_scale),
        reinterpret_cast<const void *>(b_scale),
        reinterpret_cast<bf16 *>(Y),
        /*tile_counter=*/nullptr,
        stream);
}
