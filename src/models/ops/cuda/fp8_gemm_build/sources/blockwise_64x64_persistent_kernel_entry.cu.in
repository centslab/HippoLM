// SPDX-License-Identifier: Apache-2.0
// FP8 E4M3 GEMM with 64×64 BLOCK scales — PERSISTENT variant.
//
// Same kernel as blockwise_64x64_kernel_entry.cu.in (R5b-square 64×64
// BLOCK, BF16 scales, BLOCK_ACCUM=false), but with PERSISTENT=true so
// the launch is gridDim = num_sm (1 CTA per SM, work-stealing via the
// global atomic counter in `workspace`).
//
// Why this exists (2026-07-25): the strided pattern (PERSISTENT=false)
// already does multiple tiles per CTA, but the per-tile assignment is
// fixed (blockIdx.x + k * num_blocks). With 36 SMs × occ=2 = 72 CTAs
// for the bm128/wn64 config, every CTA does 256/72 ≈ 3-4 tiles at
// prod shape M=1024. The CTA ordering doesn't matter when tile times
// are uniform (our case), so the strided pattern is already near
// optimal. PERSISTENT trades the 2-CTA/SM epilogue/K-loop overlap for
// dynamic work stealing — primarily a feasibility probe to measure
// whether the load-balancing / launch-scheduling win justifies losing
// occ=2.
//
// Workspace contract: the host passes a uint32_t* (cudaMalloc'd, 4
// bytes). The run() function seeds it with num_blocks (= gridDim.x)
// before launch — so each CTA starts with tile_id = blockIdx.x and
// the FIRST atomicAdd returns num_blocks. The kernel atomically
// increments this counter; tile_id = atomicAdd returns the next
// claimable slot.
#include "fp8_gemm.cuh"

extern "C" void blockwise_64x64_persistent_gemm_run(
    int M, int N, int K,
    const void *A, const void *B, void *Y,
    const void *a_scale, const void *b_scale,
    void *workspace, cudaStream_t stream)
{
    uint32_t *tile_counter = reinterpret_cast<uint32_t *>(workspace);
    FP8GemmMMA<BM, BN, BK, NUM_STAGES, CWG, WARP_M, WARP_N, DIRECT_STORE,
               true, /*DUAL_ACCUM=*/false, /*BLOCK_SCALE_K=*/64,
               /*BLOCK_TILE_SCALE=*/true, /*BLOCK_OUT_M=*/64,
               /*BLOCK_OUT_N=*/64,
               /*BLOCK_ACCUM=*/false,
               /*SCALE_FP32=*/false,
               /*PERSISTENT=*/true>::run(
        M, N, K,
        reinterpret_cast<const fp8e4m3 *>(A),
        reinterpret_cast<const fp8e4m3 *>(B),
        nullptr, nullptr,
        reinterpret_cast<const bf16 *>(a_scale),
        reinterpret_cast<const bf16 *>(b_scale),
        reinterpret_cast<bf16 *>(Y),
        tile_counter,
        stream);
}