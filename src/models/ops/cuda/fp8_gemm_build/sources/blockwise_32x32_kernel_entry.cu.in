// SPDX-License-Identifier: Apache-2.0
// FP8 E4M3 GEMM with 32×32 BLOCK scales + FP32 scale precision.
//
// a_scale [M/32, K/32], b_scale [N/32, K/32] (FP32 — see SCALE_FP32
// rationale in fp8_gemm.cuh). Each (m_tile, n_tile) = (32×32) maps to
// one scale per K-block. With WARP_M=32 / WARP_N=32, each warp fits
// inside exactly one (m_tile, n_tile), so the LDG+FMUL is warp-constant
// (compiler hoists it out of the (mi, ni) loops).
//
// Why FP32 scales (not BF16): QMMA m16n8k32.f32.e4m3.e4m3 is FP32-only
// on sm_120 — the accumulator is always FP32, no .f16 / .bf16 variant.
// At BLOCK_OUT=32×32 (= 32×32×32 = 32K FP8 elements per scale), the
// per-scale averaging is small enough that BF16's 7-bit mantissa can
// lose >1% relative precision on outlier magnitudes. FP32 scales match
// the accumulator precision exactly. For larger BLOCK_OUT (≥ 64×64 =
// ≥ 128K elements/scale), BF16 scales are bit-exact convertible to
// FP32, so the existing 64×64 / 128×128 / 256×256 entries keep BF16
// (halves HBM bandwidth for scales, no precision cost).
#include "fp8_gemm.cuh"

extern "C" void blockwise_32x32_gemm_run(
    int M, int N, int K,
    const void *A, const void *B, void *Y,
    const void *a_scale, const void *b_scale,
    void *workspace, cudaStream_t stream)
{
    (void)workspace;
    FP8GemmMMA<BM, BN, BK, NUM_STAGES, CWG, WARP_M, WARP_N, DIRECT_STORE,
               true, /*DUAL_ACCUM=*/false, /*BLOCK_SCALE_K=*/32,
               /*BLOCK_TILE_SCALE=*/true, /*BLOCK_OUT_M=*/32,
               /*BLOCK_OUT_N=*/32,
               /*BLOCK_ACCUM=*/false,
               /*SCALE_FP32=*/true,
               /*PERSISTENT=*/false>::run(
        M, N, K,
        reinterpret_cast<const fp8e4m3 *>(A),
        reinterpret_cast<const fp8e4m3 *>(B),
        nullptr, nullptr,
        reinterpret_cast<const float *>(a_scale),
        reinterpret_cast<const float *>(b_scale),
        reinterpret_cast<bf16 *>(Y),
        /*tile_counter=*/nullptr,
        stream);
}