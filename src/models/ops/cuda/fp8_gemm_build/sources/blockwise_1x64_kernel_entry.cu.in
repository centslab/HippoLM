// FP8 E4M3 GEMM with BF16 per-1x64 K-block scales — R5b larger block.
//
// 1×64 means a_scale [M, K/64], b_scale [N, K/64]. For BK=128 with
// MMA_K=4, two consecutive K-sub-MMAs (ki=0,1 and ki=2,3) share one
// scale — so the fma epilogue halves the LDG count vs 1×32.
//
// Numerical expectation: lower precision than 1×32 (larger scale
// blocks absorb more within-block variance). Measure sig_rel before
// shipping.
#include "fp8_gemm.cuh"

extern "C" void blockwise_1x64_gemm_run(
    int M, int N, int K,
    const void *A, const void *B, void *Y,
    const void *a_scale, const void *b_scale,
    void *workspace, cudaStream_t stream)
{
    (void)workspace;
    FP8GemmMMA<BM, BN, BK, NUM_STAGES, CWG, WARP_M, WARP_N, DIRECT_STORE, true, false, 64,
               /*BLOCK_TILE_SCALE=*/false, /*BLOCK_OUT_M=*/64, /*BLOCK_OUT_N=*/64,
               /*BLOCK_ACCUM=*/false, /*SCALE_FP32=*/false, /*PERSISTENT=*/false>::run(
        M, N, K,
        reinterpret_cast<const fp8e4m3 *>(A),
        reinterpret_cast<const fp8e4m3 *>(B),
        nullptr, nullptr,
        reinterpret_cast<const void *>(a_scale),
        reinterpret_cast<const void *>(b_scale),
        reinterpret_cast<bf16 *>(Y),
        /*tile_counter=*/nullptr,
        stream);
}