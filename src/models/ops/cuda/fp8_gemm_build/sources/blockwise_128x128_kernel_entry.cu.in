// FP8 E4M3 GEMM with 128×128 BLOCK scales — 2D-block sweep point.
//
// a_scale [M/128, K/64], b_scale [N/128, K/64]. One scale per
// (128-row × 128-col × 64-K) tile. Same warp-constant hoisting as the
// 64×64 variant (BLOCK_OUT >= warp shape), so LDG/FMUL counts match;
// this point measures whether a coarser output tile changes throughput.
#include "fp8_gemm.cuh"

extern "C" void blockwise_128x128_gemm_run(
    int M, int N, int K,
    const void *A, const void *B, void *Y,
    const void *a_scale, const void *b_scale,
    void *workspace, cudaStream_t stream)
{
    (void)workspace;
    FP8GemmMMA<BM, BN, BK, NUM_STAGES, CWG, WARP_M, WARP_N, DIRECT_STORE,
               true, /*DUAL_ACCUM=*/false, /*BLOCK_SCALE_K=*/64,
               /*BLOCK_TILE_SCALE=*/true, /*BLOCK_OUT_M=*/128,
               /*BLOCK_OUT_N=*/128,
               /*BLOCK_ACCUM=*/false,
               /*SCALE_FP32=*/false,
               /*PERSISTENT=*/false>::run(
        M, N, K,
        reinterpret_cast<const fp8e4m3 *>(A),
        reinterpret_cast<const fp8e4m3 *>(B),
        nullptr, nullptr,
        reinterpret_cast<const void *>(a_scale),
        reinterpret_cast<const void *>(b_scale),
        reinterpret_cast<bf16 *>(Y),
        /*tile_counter=*/nullptr,
        stream);
}
