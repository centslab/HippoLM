// SPDX-License-Identifier: Apache-2.0
// R10: R6 native-accumulate FP8 GEMM with F16 in-block accumulator
// (ACC_RAW_F16=true). The 128-K scale-block QMMA chain accumulates in
// F16 (mma...f16.e4m3.e4m3.f16), which sustains ~2x the F32-acc issue
// rate on sm_120's consumer Blackwell tensor core:
//   4096^3: 97.9 -> 168.3 TF (1.72x); M=8192/K=8192 shapes: 54 -> 169 TF (3.1x)
// (= 96% of cuBLASLt nvjet TensorWise scalar at the same shapes).
// NOTE (2026-07-27 audit): TF numbers used the buggy cudaEvent single-event
// timing; real ~81 TF (1.74x ratio to R7 ~47 TF preserved). See memory
// `feedback_cudaevent_2x_underreport_2026_07_27.md`.
// Numerics: med_rel 0.107% -> 0.114% (Gaussian + sharp 2^-4..2^4
// scales), ~100x below the FP8 floor. OVERFLOW BOUNDARY: acc_raw sums
// 128 raw FP8 products in F16 (max 65504) before the FP32 flush —
// safe for scale-normalized data, Inf for adversarial max-magnitude
// FP8 (448x448). See fp8_gemm.cuh ACC_RAW_F16 comment.
#include "fp8_gemm.cuh"

extern "C" void blockwise_accum_bsk128_f16_gemm_run(
    int M, int N, int K,
    const void *A, const void *B, void *Y,
    const void *a_scale, const void *b_scale,
    void *workspace, cudaStream_t stream)
{
    (void)workspace;
    FP8GemmMMA<BM, BN, BK, NUM_STAGES, CWG, WARP_M, WARP_N, DIRECT_STORE,
               /*BLOCKWISE_SCALE=*/true, /*DUAL_ACCUM=*/false,
               /*BLOCK_SCALE_K=*/128,
               /*BLOCK_TILE_SCALE=*/true, /*BLOCK_OUT_M=*/64,
               /*BLOCK_OUT_N=*/64, /*BLOCK_ACCUM=*/true,
               /*SCALE_FP32=*/false, /*PERSISTENT=*/false,
               /*ACC_RAW_F16=*/true>::run(
        M, N, K,
        reinterpret_cast<const fp8e4m3 *>(A),
        reinterpret_cast<const fp8e4m3 *>(B),
        nullptr, nullptr,
        reinterpret_cast<const void *>(a_scale),
        reinterpret_cast<const void *>(b_scale),
        reinterpret_cast<bf16 *>(Y),
        /*tile_counter=*/nullptr,
        stream);
}
